# LAP Ops — Email configuration
# Copy this file to `ops/.env` and fill in your values.
# The .env file is gitignored and never committed.

# ──── Required ────

# Resend API key. Sign up at https://resend.com (free tier: 100 emails/day).
# Create a key at https://resend.com/api-keys (starts with re_...).
RESEND_API_KEY=re_REPLACE_ME

# ──── Optional (have sensible defaults) ────

# Where all emails go.
EMAIL_TO=theos.eleve@gmail.com

# From-address. You can use Resend's shared sender with no domain setup:
EMAIL_FROM=LAP Ops <onboarding@resend.dev>
# Later, if you verify a domain on Resend, switch to e.g.:
# EMAIL_FROM=LAP Ops <ops@lap.racing>
